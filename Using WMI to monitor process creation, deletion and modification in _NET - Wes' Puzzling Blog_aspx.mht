s/wmisdk/wmi/wmi_reference.asp">WMI</A>=20
 is a powerful tool and I have just recently discovered some of its =
power.=20
 Previously I though the only way to detect process creation was by =
creating a=20
 windows hook but now I know it is fairly simple to due with =
.NET&nbsp;using the=20
<A=20
href=3D"http://msdn2.microsoft.com/en-us/library/system.management.aspx">=
Windows.Management</A>=20
 namespace. Below is simple ProcessWatcher class that has events that =
are=20
 triggered when a process is created, deleted or modified. =
Enjoy!</P><PRE><SPAN style=3D"color: blue;">using</SPAN> System;=0A=
<SPAN style=3D"color: blue;">using</SPAN> System.ComponentModel;=0A=
<SPAN style=3D"color: blue;">using</SPAN> System.Collections;=0A=
<SPAN style=3D"color: blue;">using</SPAN> System.Globalization;=0A=
<SPAN style=3D"color: blue;">using</SPAN> System.Management;=0A=
=0A=
<SPAN style=3D"color: blue;">namespace</SPAN> WMI.Win32=0A=
{=0A=
    <SPAN style=3D"color: blue;">public</SPAN> <SPAN style=3D"color: =
blue;">delegate</SPAN> <SPAN style=3D"color: blue;">void</SPAN> =
ProcessEventHandler(Win32_Process proc);=0A=
    <SPAN style=3D"color: blue;">public</SPAN> <SPAN style=3D"color: =
blue;">class</SPAN> ProcessWatcher : ManagementEventWatcher=0A=
    {=0A=
        <SPAN style=3D"color: green;">// Process Events</SPAN>=0A=
        <SPAN style=3D"color: blue;">public</SPAN> <SPAN style=3D"color: =
blue;">event</SPAN> ProcessEventHandler ProcessCreated;=0A=
        <SPAN style=3D"color: blue;">public</SPAN> <SPAN style=3D"color: =
blue;">event</SPAN> ProcessEventHandler ProcessDeleted;=0A=
        <SPAN style=3D"color: blue;">public</SPAN> <SPAN style=3D"color: =
blue;">event</SPAN> ProcessEventHandler ProcessModified;=0A=
=0A=
        <SPAN style=3D"color: green;">// WMI WQL process query =
strings</SPAN>=0A=
        <SPAN style=3D"color: blue;">static</SPAN> <SPAN style=3D"color: =
blue;">readonly</SPAN> <SPAN style=3D"color: blue;">string</SPAN> =
WMI_OPER_EVENT_QUERY =3D <SPAN style=3D"color: maroon;">@"SELECT * FROM =0A=
__InstanceOperationEvent WITHIN 1 WHERE TargetInstance ISA =
'Win32_Process'"</SPAN>;=0A=
        <SPAN style=3D"color: blue;">static</SPAN> <SPAN style=3D"color: =
blue;">readonly</SPAN> <SPAN style=3D"color: blue;">string</SPAN> =
WMI_OPER_EVENT_QUERY_WITH_PROC =3D=0A=
            WMI_OPER_EVENT_QUERY + <SPAN style=3D"color: maroon;">" and =
TargetInstance.Name =3D '{0}'"</SPAN>;=0A=
=0A=
        <SPAN style=3D"color: blue;">public</SPAN> ProcessWatcher()=0A=
        {=0A=
            Init(<SPAN style=3D"color: blue;">string</SPAN>.Empty);=0A=
        }=0A=
        <SPAN style=3D"color: blue;">public</SPAN> ProcessWatcher(<SPAN =
style=3D"color: blue;">string</SPAN> processName)=0A=
        {=0A=
            Init(processName);=0A=
        }=0A=
        <SPAN style=3D"color: blue;">private</SPAN> <SPAN =
style=3D"color: blue;">void</SPAN> Init(<SPAN style=3D"color: =
blue;">string</SPAN> processName)=0A=
        {=0A=
            <SPAN style=3D"color: blue;">this</SPAN>.Query.QueryLanguage =
=3D <SPAN style=3D"color: maroon;">"WQL"</SPAN>;=0A=
            <SPAN style=3D"color: blue;">if</SPAN> (<SPAN =
style=3D"color: blue;">string</SPAN>.IsNullOrEmpty(processName))=0A=
            {=0A=
                <SPAN style=3D"color: =
blue;">this</SPAN>.Query.QueryString =3D WMI_OPER_EVENT_QUERY;=0A=
            }=0A=
            <SPAN style=3D"color: blue;">else</SPAN>=0A=
            {=0A=
                <SPAN style=3D"color: =
blue;">this</SPAN>.Query.QueryString =3D=0A=
                    <SPAN style=3D"color: =
blue;">string</SPAN>.Format(WMI_OPER_EVENT_QUERY_WITH_PROC, processName);=0A=
            }=0A=
=0A=
            <SPAN style=3D"color: blue;">this</SPAN>.EventArrived +=3D =
<SPAN style=3D"color: blue;">new</SPAN> =
EventArrivedEventHandler(watcher_EventArrived);=0A=
        }=0A=
        <SPAN style=3D"color: blue;">private</SPAN> <SPAN =
style=3D"color: blue;">void</SPAN> watcher_EventArrived(<SPAN =
style=3D"color: blue;">object</SPAN> sender, EventArrivedEventArgs e)=0A=
        {=0A=
            <SPAN style=3D"color: blue;">string</SPAN> eventType =3D =
e.NewEvent.ClassPath.ClassName;=0A=
            Win32_Process proc =3D <SPAN style=3D"color: =
blue;">new</SPAN> =0A=
                Win32_Process(e.NewEvent[<SPAN style=3D"color: =
maroon;">"TargetInstance"</SPAN>] <SPAN style=3D"color: blue;">as</SPAN> =
ManagementBaseObject);=0A=
=0A=
            <SPAN style=3D"color: blue;">switch</SPAN> (eventType)=0A=
            {=0A=
                <SPAN style=3D"color: blue;">case</SPAN> <SPAN =
style=3D"color: maroon;">"__InstanceCreationEvent"</SPAN>:=0A=
                    <SPAN style=3D"color: blue;">if</SPAN> =
(ProcessCreated !=3D <SPAN style=3D"color: blue;">null</SPAN>) =
ProcessCreated(proc); <SPAN style=3D"color: blue;">break</SPAN>;=0A=
                <SPAN style=3D"color: blue;">case</SPAN> <SPAN =
style=3D"color: maroon;">"__InstanceDeletionEvent"</SPAN>:=0A=
                    <SPAN style=3D"color: blue;">if</SPAN> =
(ProcessDeleted !=3D <SPAN style=3D"color: blue;">null</SPAN>) =
ProcessDeleted(proc); <SPAN style=3D"color: blue;">break</SPAN>;=0A=
                <SPAN style=3D"color: blue;">case</SPAN> <SPAN =
style=3D"color: maroon;">"__InstanceModificationEvent"</SPAN>:=0A=
                    <SPAN style=3D"color: blue;">if</SPAN> =
(ProcessModified !=3D <SPAN style=3D"color: blue;">null</SPAN>) =
ProcessModified(proc); <SPAN style=3D"color: blue;">break</SPAN>;=0A=
            }=0A=
        }=0A=
    }=0A=
=0A=
    <SPAN style=3D"color: green;">// Auto-Generated running: =
mgmtclassgen Win32_Process /n root\cimv2 /o WMI.Win32</SPAN>=0A=
    <SPAN style=3D"color: green;">// Renaming the class from Process to =
Win32_Process</SPAN>=0A=
    <SPAN style=3D"color: blue;">public</SPAN> <SPAN style=3D"color: =
blue;">class</SPAN> Win32_Process { ... }=0A=
}=0A=
=0A=
<SPAN style=3D"color: green;">// Sample Usage</SPAN>=0A=
ProcessWatcher procWatcher =3D <SPAN style=3D"color: blue;">new</SPAN> =
ProcessWatcher(<SPAN style=3D"color: maroon;">"notepad.exe"</SPAN>);=0A=
procWatcher.ProcessCreated +=3D <SPAN style=3D"color: blue;">new</SPAN> =
ProcessEventHandler(procWatcher_ProcessCreated);=0A=
procWatcher.ProcessDeleted +=3D <SPAN style=3D"color: blue;">new</SPAN> =
ProcessEventHandler(procWatcher_ProcessDeleted);=0A=
procWatcher.ProcessModified +=3D <SPAN style=3D"color: blue;">new</SPAN> =
ProcessEventHandler(procWatcher_ProcessModified);=0A=
procWatcher.Start();=0A=
=0A=
<SPAN style=3D"color: green;">// Do Work</SPAN>=0A=
=0A=
procWatcher.Stop();<!--StartFragment --></PRE>
