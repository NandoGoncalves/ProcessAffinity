<Window x:Class="ProcessAffinityUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProcessAffinity" mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Height="411" Width="600" Icon="ProcessAffinity.ico" >

    <Window.Resources>
        <!-- Teintes du champ de recherche, reprises de celles de Windows 11 : un
             cadre discret, un gris de glyphe lisible sans être noir, et l'accent
             du système pour le soulignement de focus. -->
        <SolidColorBrush x:Key="SearchBorderBrush" Color="#FFBFBFBF" />
        <SolidColorBrush x:Key="SearchGlyphBrush" Color="#FF6B6B6B" />
        <SolidColorBrush x:Key="SearchAccentBrush" Color="#FF0067C0" />
    </Window.Resources>

    <Grid>
        <DockPanel LastChildFill="True">
            <Menu DockPanel.Dock="Top" Background="White">
                <!-- Le panneau d'éléments est un DockPanel pour que « ? » se range
                     à droite sans que la barre cesse d'occuper toute la largeur :
                     un simple HorizontalAlignment sur le Menu l'aurait rétréci. -->
                <Menu.ItemsPanel>
                    <ItemsPanelTemplate>
                        <DockPanel HorizontalAlignment="Stretch" LastChildFill="False" />
                    </ItemsPanelTemplate>
                </Menu.ItemsPanel>
                <!-- Marge droite de 31 px : les trois commandes de coin — « Load »,
                     « ? » et « Close » — tombent sur le même bord. Load en est la
                     référence, avec sa marge de 30 px plus le pixel de bordure de
                     son cadre ; le menu n'a pas de cadre, d'où les 31 ici. -->
                <MenuItem Header="?" DockPanel.Dock="Right" Name="HelpMenuItem" Margin="0,0,31,0">
                    <MenuItem Header="_Help…" Name="HelpContentMenuItem" Click="HelpContentMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="_About ProcessAffinity…" Name="AboutMenuItem" Click="AboutMenuItem_Click" />
                </MenuItem>
            </Menu>
            <Border Height="45" Background="White" BorderBrush="Black" BorderThickness="1" DockPanel.Dock="Top" FlowDirection="LeftToRight">
                <Grid ShowGridLines="True">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBox Height="20" HorizontalAlignment="Left" Margin="6,17,0,0" Name="ComputerNameTextBox" VerticalAlignment="Top" Width="102" FontSize="10" FontWeight="Black" TabIndex="1" Text="." Visibility="Collapsed" />
                    <Button Content="Load" Height="20" HorizontalAlignment="Right" Margin="0,16,30,0" Name="loadProcessesButton" VerticalAlignment="Top" Width="75" Click="loadProcessesButton_Click" TabIndex="5" />
                    <TextBox Height="20" HorizontalAlignment="Left" Margin="122,17,0,0" Name="DomainTextBox" VerticalAlignment="Top" Width="102" FontSize="10" FontWeight="Black" TabIndex="2" Text="" Visibility="Collapsed" />
                    <TextBox Height="20" HorizontalAlignment="Left" Margin="238,16,0,0" Name="UsertextBox" VerticalAlignment="Top" Width="102" FontSize="10" FontWeight="Black" TabIndex="3" Text="" Visibility="Collapsed" />
                    <Label Content="Computer" Height="21" HorizontalAlignment="Left" Margin="6,-1,0,0" Name="ComputerNameLabel" VerticalAlignment="Top" FontSize="8" FontWeight="ExtraBold" Visibility="Collapsed" />
                    <Label Content="Domain" FontSize="8" FontWeight="ExtraBold" Height="21" HorizontalAlignment="Left" Margin="122,0,0,0" Name="DomainLabel" VerticalAlignment="Top" Visibility="Collapsed" />
                    <Label Content="User" FontSize="8" FontWeight="ExtraBold" Height="21" HorizontalAlignment="Left" Margin="238,-1,0,0" Name="UserLabel" VerticalAlignment="Top" Visibility="Collapsed" />
                    <Label Content="Password" FontSize="8" FontWeight="ExtraBold" HorizontalAlignment="Left" Margin="353,-1,0,24" Name="Passwordlabel" Visibility="Collapsed" />
                    <PasswordBox Height="21" HorizontalAlignment="Left" Margin="353,15,0,0" Name="passwordBox" VerticalAlignment="Top" Width="120" FontSize="10" FontWeight="Black" TabIndex="4" Password="" Visibility="Collapsed" />
                    <CheckBox Content="Show services" Height="20" HorizontalAlignment="Left" Margin="6,17,0,0" Name="ShowServicesCheckBox" VerticalAlignment="Top" Width="100" FontSize="10" IsChecked="False" Checked="ShowServicesCheckBox_CheckedChanged" Unchecked="ShowServicesCheckBox_CheckedChanged" />
                    <!-- Ce que les tuiles tracent. Le CPU est coché par défaut, la
                         mémoire non : elle passe derrière, et l'afficher d'office
                         chargerait la tuile pour qui ne la cherche pas.
                         Sans libellé au-dessus : deux cases nommées « CPU » et
                         « RAM » à côté de « Show services » se comprennent seules. -->
                    <CheckBox Content="CPU" Height="20" HorizontalAlignment="Left" Margin="112,17,0,0" Name="ShowCpuBarsCheckBox" VerticalAlignment="Top" Width="48" FontSize="10" IsChecked="True" ToolTip="Draw the CPU history on each tile" Checked="BarsCheckBox_CheckedChanged" Unchecked="BarsCheckBox_CheckedChanged" />
                    <CheckBox Content="RAM" Height="20" HorizontalAlignment="Left" Margin="162,17,0,0" Name="ShowMemoryBarsCheckBox" VerticalAlignment="Top" Width="48" FontSize="10" IsChecked="False" ToolTip="Draw the memory history behind the CPU bars, and the gauge on the left edge" Checked="BarsCheckBox_CheckedChanged" Unchecked="BarsCheckBox_CheckedChanged" />
                    <!-- Champ de recherche à la manière du Gestionnaire des tâches
                         de Windows 11 : cadre arrondi, loupe à gauche, texte
                         indicatif à l'intérieur plutôt qu'un libellé au-dessus, et
                         un soulignement d'accentuation quand le champ a le focus.
                         Le libellé disparu libère une ligne dans une barre où la
                         place manque. -->
                    <Border Name="NameFilterBorder" Height="26" Width="210" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="216,10,0,0" CornerRadius="4" Background="White"
                            BorderBrush="{StaticResource SearchBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Loupe dessinée au trait : une police d'icônes peut
                                 manquer, un tracé non. -->
                            <Canvas Grid.Column="0" Width="14" Height="14" Margin="7,0,4,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Ellipse Canvas.Left="1" Canvas.Top="1" Width="9" Height="9"
                                         Stroke="{StaticResource SearchGlyphBrush}" StrokeThickness="1.3" />
                                <Line X1="9" Y1="9" X2="12.5" Y2="12.5"
                                      Stroke="{StaticResource SearchGlyphBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>

                            <TextBox Grid.Column="1" Name="NameFilterTextBox" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     FontSize="11" TabIndex="6" BorderThickness="0" Background="Transparent" Padding="0"
                                     TextChanged="NameFilterTextBox_TextChanged" GotKeyboardFocus="NameFilterTextBox_FocusChanged" LostKeyboardFocus="NameFilterTextBox_FocusChanged" />

                            <!-- Texte indicatif : un TextBlock derrière le champ,
                                 masqué dès qu'on saisit. Il ne peut pas être pris
                                 pour du contenu, le champ restant vide. -->
                            <TextBlock Grid.Column="1" Name="NameFilterPlaceholder" Text="Search processes" VerticalAlignment="Center"
                                       FontSize="11" Foreground="{StaticResource SearchGlyphBrush}" IsHitTestVisible="False" />

                            <!-- Vider le filtre en un geste : la croix n'apparaît
                                 que lorsqu'il y a quelque chose à effacer. -->
                            <Button Grid.Column="2" Content="✕" Width="20" Height="20" Name="ClearNameFilterButton"
                                    VerticalAlignment="Center" Margin="0,0,3,0" FontSize="9" Padding="0"
                                    BorderThickness="0" Background="Transparent" Foreground="{StaticResource SearchGlyphBrush}"
                                    ToolTip="Clear the name filter" Visibility="Collapsed"
                                    Click="ClearNameFilterButton_Click" TabIndex="7" />
                        </Grid>
                    </Border>

                    <!-- Soulignement d'accentuation, posé sous le cadre et révélé
                         au focus. Un rectangle plutôt qu'une bordure épaissie : la
                         hauteur du champ ne doit pas bouger quand on y entre. -->
                    <Rectangle Name="NameFilterAccent" Height="2" Width="208" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="217,34,0,0" Fill="{StaticResource SearchAccentBrush}" Visibility="Collapsed" />
                </Grid>
            </Border>
            <Border Height="44" Background="White" BorderBrush="Black" BorderThickness="1" DockPanel.Dock="Bottom">
                <!-- Le bouton est ancré au bord par le DockPanel, et non posé à une
                     marge absolue : il reste au coin quelle que soit la largeur. -->
                <DockPanel LastChildFill="True">
                <Button Content="Close" DockPanel.Dock="Right" Name="CloseButton" Width="75" Height="22"
                        Margin="6,0,30,0" VerticalAlignment="Center" Click="CloseButton_Click" TabIndex="8" />
                <TextBlock Foreground="Black" Height="45"><InlineUIContainer>
                		<ComboBox x:Name="CPUComboBox" Height="30" Width="50" RenderTransformOrigin="0.625,2.314" FontSize="8"  />
                	</InlineUIContainer>
                    <InlineUIContainer>
                        <Label Content="Displayed: 0" x:Name="ProcessControlsCountLabel" HorizontalContentAlignment="Right" Padding="2,5,2,5" />
                    </InlineUIContainer>
                    <InlineUIContainer>
                        <Label Content="/" x:Name="Slash0Label" HorizontalContentAlignment="Center" Padding="2,5,2,5" />
                    </InlineUIContainer>
                    <InlineUIContainer>
                        <Label Content="Total: 0" x:Name="ProcessesCountLabel" HorizontalContentAlignment="Left" Padding="2,5,2,5" />
                    </InlineUIContainer>
                    <InlineUIContainer>
                        <!-- Masqué tant qu'aucune tuile n'est cochée, sur le modèle
                             du compteur de règles en échec. -->
                        <Label Content="" x:Name="SelectedCountLabel" Padding="2,5,2,5"
                               Foreground="#1F5C99" FontWeight="Bold" Visibility="Collapsed" />
                    </InlineUIContainer>
                    <InlineUIContainer>
                        <!-- Masqué tant qu'aucune règle n'est en échec : un compteur
                             à zéro en permanence n'apprend rien et encombre. -->
                        <Label Content="" x:Name="FailedRulesLabel" Padding="2,5,2,5"
                               Foreground="#A5322A" FontWeight="Bold" Visibility="Collapsed" />
                    </InlineUIContainer>
                </TextBlock>
                </DockPanel>
            </Border>
            <Border Width="50" Background="White" BorderBrush="Black" BorderThickness="1" DockPanel.Dock="Left">
                <TextBlock Foreground="Black" />
            </Border>
            <Border Background="White" BorderBrush="Black" BorderThickness="1"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                <ScrollViewer x:Name="processScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <WrapPanel Background="White"  Name="processWrapPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  />
                </ScrollViewer>
            </Border>

        </DockPanel>

    </Grid>
</Window>
