<Window x:Class="ProcessAffinityUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="640" Width="920" MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="ProcessAffinity.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="WarningBorderBrush" Color="#FFA5322A" />
        <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFFDF2F1" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF6B6B6B" />

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Name="SettingsTabControl">

            <!-- ============================ Onglet 1 : les règles ========== -->
            <TabItem Header="Saved configurations" Name="RulesTabItem">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Fichier refusé pour format trop récent. Rien n'a été
                         chargé : la liste est vide et le dire est le seul moyen
                         d'éviter qu'un enregistrement ultérieur ne remplace tout. -->
                    <Border Grid.Row="0" Name="RejectedFileBorder" Visibility="Collapsed"
                            BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1"
                            Background="{StaticResource WarningBackgroundBrush}"
                            Padding="10" Margin="0,0,0,10" CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Name="RejectedFileTitleTextBlock" FontWeight="Bold"
                                           TextWrapping="Wrap" Text="The rules file was not loaded." />
                                <TextBlock Name="RejectedFileTextBlock" TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1" Name="ExportRejectedButton" Content="Export the file…"
                                    Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Top"
                                    Click="ExportRulesButton_Click" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Every rule in the rules file, whether or not the program is running. A rule is created from a running process with “Save configuration”; it can be changed or removed here." />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Name="EditRuleButton" Content="Edit…" Width="90" Padding="0,4"
                                Click="EditRuleButton_Click" IsEnabled="False" />
                        <Button Name="DeleteRuleButton" Content="Delete" Width="90" Padding="0,4"
                                Margin="6,0,0,0" Click="DeleteRuleButton_Click" IsEnabled="False" />
                        <Button Name="ExportRulesButton" Content="Export…" Width="90" Padding="0,4"
                                Margin="6,0,0,0" Click="ExportRulesButton_Click"
                                ToolTip="Write a copy of the rules file somewhere else" />
                        <TextBlock Name="RuleCountTextBlock" VerticalAlignment="Center" Margin="14,0,0,0"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>

                    <ListView Grid.Row="3" Name="RulesListView" SelectionMode="Extended"
                              SelectionChanged="RulesListView_SelectionChanged"
                              MouseDoubleClick="RulesListView_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Executable" Width="320"
                                                DisplayMemberBinding="{Binding ExecutablePath}" />
                                <GridViewColumn Header="Affinity" Width="150"
                                                DisplayMemberBinding="{Binding Affinity}" />
                                <GridViewColumn Header="Priority" Width="90"
                                                DisplayMemberBinding="{Binding Priority}" />
                                <GridViewColumn Header="Efficiency" Width="110"
                                                DisplayMemberBinding="{Binding EfficiencyMode}" />
                                <GridViewColumn Header="CPU Sets" Width="100"
                                                DisplayMemberBinding="{Binding CpuSets}" />
                                <GridViewColumn Header="State" Width="140"
                                                DisplayMemberBinding="{Binding State}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="4" Margin="0,8,0,0" Padding="8" Background="#FFF5F5F5"
                            BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="3">
                        <TextBlock Name="RuleStateExplanationTextBlock" TextWrapping="Wrap" MinHeight="32"
                                   Text="Select a rule to see what its state means." />
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================ Onglet 2 : les couleurs ======== -->
            <TabItem Header="Colors" Name="ColorsTabItem">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Much of what a tile tells you is carried by colour alone, and several of these shades sit close together on purpose. Change any of them here; the window repaints as you go." />

                    <ListBox Grid.Row="1" Grid.Column="0" Name="ColorRolesListBox"
                             SelectionChanged="ColorRolesListBox_SelectionChanged"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="34" Height="20" CornerRadius="2"
                                            BorderBrush="#FF999999" BorderThickness="1"
                                            Background="{Binding Swatch}" />

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                   FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Hex}" VerticalAlignment="Center"
                                               Margin="8,0,4,0" FontFamily="Consolas"
                                               Foreground="{StaticResource MutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Panneau d'édition. L'aperçu se met à jour au trait,
                         l'application se repeint après une courte pause : un
                         repeint par pixel de glissière rendrait la glissière
                         inutilisable sur cinq cents tuiles. -->
                    <Border Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Padding="10"
                            BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="3">
                        <StackPanel Name="ColorEditorPanel" IsEnabled="False">
                            <TextBlock Name="EditedRoleNameTextBlock" Style="{StaticResource SectionTitleStyle}"
                                       TextWrapping="Wrap" Text="No colour selected" />

                            <Border Name="PreviewBorder" Height="56" CornerRadius="3" Margin="0,6,0,0"
                                    BorderBrush="#FF999999" BorderThickness="1">
                                <TextBlock Name="PreviewTextBlock" Text="Sample tile name"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontWeight="SemiBold" />
                            </Border>

                            <TextBlock Text="Hex" Margin="0,10,0,2" />
                            <TextBox Name="HexTextBox" FontFamily="Consolas"
                                     TextChanged="HexTextBox_TextChanged" />

                            <TextBlock Name="RedLabel" Text="Red" Margin="0,10,0,0" />
                            <Slider Name="RedSlider" Minimum="0" Maximum="255" IsSnapToTickEnabled="True"
                                    TickFrequency="1" ValueChanged="ChannelSlider_ValueChanged" />

                            <TextBlock Name="GreenLabel" Text="Green" />
                            <Slider Name="GreenSlider" Minimum="0" Maximum="255" IsSnapToTickEnabled="True"
                                    TickFrequency="1" ValueChanged="ChannelSlider_ValueChanged" />

                            <TextBlock Name="BlueLabel" Text="Blue" />
                            <Slider Name="BlueSlider" Minimum="0" Maximum="255" IsSnapToTickEnabled="True"
                                    TickFrequency="1" ValueChanged="ChannelSlider_ValueChanged" />

                            <Border Name="ContrastBorder" Margin="0,12,0,0" Padding="8" CornerRadius="3"
                                    BorderThickness="1" BorderBrush="#FFDDDDDD" Background="#FFF5F5F5">
                                <TextBlock Name="ContrastTextBlock" TextWrapping="Wrap" FontSize="11" />
                            </Border>

                            <Button Name="ResetColorButton" Content="Reset this colour" Margin="0,12,0,0"
                                    Padding="0,5" Click="ResetColorButton_Click" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                                Margin="0,10,0,0">
                        <Button Name="ResetAllColorsButton" Content="Reset all colours" Width="140"
                                Padding="0,5" Click="ResetAllColorsButton_Click"
                                ToolTip="Put every colour back to the value it shipped with" />
                        <TextBlock Name="PaletteSummaryTextBlock" VerticalAlignment="Center" Margin="14,0,0,0"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="1" Name="CloseButton" Content="Close" Width="90" Padding="0,5"
                HorizontalAlignment="Right" Margin="0,10,0,0" IsCancel="True" Click="CloseButton_Click" />
    </Grid>
</Window>
