<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ProcessAffinityUI</RootNamespace>
    <AssemblyName>ProcessAffinityUI</AssemblyName>
    <ApplicationIcon>ProcessAffinity.ico</ApplicationIcon>

    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>ProcessAffinityUI</AssemblyTitle>
    <Product>ProcessAffinityUI</Product>
    <Copyright>Copyright ©  2013</Copyright>
    <Version>1.6.0</Version>
    <AssemblyVersion>1.6.0.0</AssemblyVersion>
    <FileVersion>1.6.0.0</FileVersion>
    <ComVisible>false</ComVisible>

    <!-- WFO1000 : nouvel analyseur WPF .NET 9 sur la sérialisation XAML des propriétés d'un Component.
         Faux positif ici : WIN32_Process (wrapper WMI généré, Win32_Process.cs) n'est jamais utilisé
         dans une surface de designer XAML. Fichier volontairement non modifié (cf. consignes). -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="9.0.20" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.20" />
  </ItemGroup>

  <ItemGroup>
    <!-- Chargées via des pack URI (Application.GetResourceStream) : doivent rester des ressources embarquées WPF. -->
    <Resource Include="ProcessAffinity.ico" />
    <Resource Include="WMIGetRemoteProcesses.txt" />
    <Resource Include="ProcessWatcher.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- ProcessRetriever.cs charge ce fichier par chemin relatif au répertoire de sortie. -->
    <None Update="ProcessAffinityUI.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
