<Window x:Class="ProcessAffinityUI.TileColorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tile background colour" Height="360" Width="340"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Icon="ProcessAffinity.ico">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Name="SubjectTextBlock" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="#FF6B6B6B" />

        <StackPanel Grid.Row="1">
            <Border Name="PreviewBorder" Height="64" CornerRadius="3"
                    BorderBrush="#FF999999" BorderThickness="1">
                <TextBlock Name="PreviewTextBlock" Text="Sample tile name"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="SemiBold" />
            </Border>

            <TextBlock Text="Hex" Margin="0,10,0,2" />
            <TextBox Name="HexTextBox" FontFamily="Consolas" TextChanged="HexTextBox_TextChanged" />

            <TextBlock Text="Red" Margin="0,8,0,0" />
            <Slider Name="RedSlider" Minimum="0" Maximum="255" IsSnapToTickEnabled="True"
                    TickFrequency="1" ValueChanged="ChannelSlider_ValueChanged" />

            <TextBlock Text="Green" />
            <Slider Name="GreenSlider" Minimum="0" Maximum="255" IsSnapToTickEnabled="True"
                    TickFrequency="1" ValueChanged="ChannelSlider_ValueChanged" />

            <TextBlock Text="Blue" />
            <Slider Name="BlueSlider" Minimum="0" Maximum="255" IsSnapToTickEnabled="True"
                    TickFrequency="1" ValueChanged="ChannelSlider_ValueChanged" />

            <TextBlock Name="ReadabilityTextBlock" TextWrapping="Wrap" FontSize="11"
                       Margin="0,10,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Name="GeneralButton" Content="Use the general colour" Padding="10,5"
                    Click="GeneralButton_Click" />
            <Button Name="OkButton" Content="OK" Width="76" Padding="0,5" Margin="8,0,0,0"
                    IsDefault="True" Click="OkButton_Click" />
            <Button Name="CancelButton" Content="Cancel" Width="76" Padding="0,5" Margin="8,0,0,0"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
