<Window x:Class="ProcessAffinityUI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About ProcessAffinity" Height="500" Width="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResize" MinHeight="320" MinWidth="380"
        Icon="ProcessAffinity.ico">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Name="ApplicationNameTextBlock" Text="ProcessAffinity" FontSize="18" FontWeight="Bold" />
            <TextBlock Name="VersionTextBlock" Text="Version" FontSize="11" Foreground="#555555" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Les indicateurs venus de la barre du bas. Ils n'ont de sens que pour
             qui développe l'application : leur place est ici, avec ce qu'ils
             comptent écrit à côté. -->
        <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1" Background="#FAFAFA"
                Padding="8" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Event subscriptions" FontWeight="Bold" FontSize="11" />
                <TextBlock Name="EventSubscriptionsTextBlock" Text="Evt:- New:- Del:- Mod:-"
                           FontFamily="Consolas" FontSize="12" Margin="0,4,0,0" />
                <TextBlock Name="EventSubscriptionsExplanationTextBlock" TextWrapping="Wrap"
                           FontSize="10" Foreground="#555555" Margin="0,4,0,0"
                           Text="These are the four process event subscriptions the main window holds on the sampling layer: any event, creation, deletion and modification. Each should be exactly 1. Any other value means a subscription was lost or registered twice, and tiles would stop following the system." />
            </StackPanel>
        </Border>

        <!-- Revenir sur un « Ne plus me le demander » : sans cette issue, le choix
             serait définitif pour qui ne sait pas où vit le fichier de
             préférences. -->
        <Border Grid.Row="2" BorderBrush="#DDDDDD" BorderThickness="1" Background="#FAFAFA"
                Padding="8" Margin="0,12,0,0">
            <DockPanel>
                <Button Name="ResetCloseChoiceButton" Content="Ask again" Width="90" Height="23"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                        Click="ResetCloseChoiceButton_Click" />
                <StackPanel>
                    <TextBlock Text="Close button" FontWeight="Bold" FontSize="11" />
                    <TextBlock Name="CloseChoiceTextBlock" TextWrapping="Wrap" FontSize="10"
                               Foreground="#555555" Margin="0,3,0,0" Text="" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Démarrage automatique. L'état affiché est lu dans le registre et non
             dans le fichier de préférences : c'est ainsi que le retrait manuel de
             l'entrée se voit ici, au lieu d'être contredit par un souvenir. -->
        <Border Grid.Row="3" BorderBrush="#DDDDDD" BorderThickness="1" Background="#FAFAFA"
                Padding="8" Margin="0,12,0,0">
            <DockPanel>
                <Button Name="StartupToggleButton" Content="Enable" Width="90" Height="23"
                        DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                        Click="StartupToggleButton_Click" />
                <StackPanel>
                    <TextBlock Text="Start with Windows" FontWeight="Bold" FontSize="11" />
                    <TextBlock Name="StartupStateTextBlock" TextWrapping="Wrap" FontSize="10"
                               Foreground="#555555" Margin="0,3,0,0" Text="" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="4" Text="Dependencies" FontWeight="Bold" FontSize="11" Margin="0,12,0,4" />

        <!-- Liste déroulante : la fenêtre reste compacte quel que soit le nombre
             d'assemblys chargés, qui varie au fil de la session. -->
        <Border Grid.Row="5" BorderBrush="#CCCCCC" BorderThickness="1">
            <ListView Name="DependenciesListView" BorderThickness="0" FontSize="11"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Component" Width="210" DisplayMemberBinding="{Binding Name}" />
                        <!-- Assez large pour « Microsoft Windows 10.0.26200 », que
                             130 px tronquaient. -->
                        <GridViewColumn Header="Version" Width="185" DisplayMemberBinding="{Binding Version}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <DockPanel Grid.Row="6" Margin="0,10,0,0">
            <TextBlock Name="DependencyCountTextBlock" DockPanel.Dock="Left" VerticalAlignment="Center"
                       FontSize="10" Foreground="#555555" Text="" />
            <Button Content="Close" Name="CloseButton" Width="80" Height="23"
                    HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="CloseButton_Click" />
        </DockPanel>
    </Grid>
</Window>
