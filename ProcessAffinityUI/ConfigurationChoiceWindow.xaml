<Window x:Class="ProcessAffinityUI.ConfigurationChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Which configuration should be saved?" Height="360" Width="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResize" MinHeight="280" MinWidth="440"
        Icon="ProcessAffinity.ico">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Name="HeaderTextBlock" TextWrapping="Wrap" FontSize="12" FontWeight="Bold" Text="" />
            <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#555555" Margin="0,4,0,0"
                       Text="A rule is attached to the executable, so only one configuration can be saved for it. Pick the one to keep, or skip this program and save nothing for it." />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,10,0,0">
            <ListBox Name="ChoicesListBox" BorderThickness="0" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,5,2,5">
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11" />
                            <TextBlock Text="{Binding InstanceSummary}" FontSize="10" Foreground="#555555" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <!-- Passer est indispensable : une boîte modale sans issue bloquerait un
                 geste de masse sur un conflit dont l'utilisateur ne veut pas
                 s'occuper. -->
            <Button Name="SkipButton" Content="Skip this program" Width="140" Height="24"
                    DockPanel.Dock="Left" HorizontalAlignment="Left" IsCancel="True" Click="SkipButton_Click" />
            <Button Name="SaveButton" Content="Save this configuration" Width="170" Height="24"
                    DockPanel.Dock="Right" HorizontalAlignment="Right" IsDefault="True" Click="SaveButton_Click" />
        </DockPanel>
    </Grid>
</Window>
