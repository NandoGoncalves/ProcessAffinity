<Window x:Class="ProcessAffinityUI.StartupPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start ProcessAffinity with Windows?" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize" Icon="ProcessAffinity.ico">

    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" FontSize="12"
                   Text="ProcessAffinity applies your saved rules only while it runs. Starting it with Windows means your rules are applied to programs launched before you open it." />

        <TextBlock Name="RegistryPathTextBlock" TextWrapping="Wrap" FontSize="10" Foreground="#555555" Margin="0,8,0,0"
                   Text="" />

        <CheckBox Name="DoNotAskCheckBox" Content="Don't ask me again" Margin="0,16,0,0" FontSize="11" />
        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#555555" Margin="20,3,0,0"
                   Text="You can change this at any time from the ? menu, under About." />

        <DockPanel Margin="0,16,0,0">
            <Button Name="NoButton" Content="Not now" Width="110" Height="24"
                    DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="8,0,0,0"
                    IsCancel="True" Click="NoButton_Click" />
            <Button Name="YesButton" Content="Start with Windows" Width="160" Height="24"
                    DockPanel.Dock="Right" HorizontalAlignment="Right"
                    IsDefault="True" Click="YesButton_Click" />
            <TextBlock />
        </DockPanel>
    </StackPanel>
</Window>
