<Window x:Class="ProcessAffinityUI.CloseConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close ProcessAffinity" SizeToContent="Height" Width="470"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize" Icon="ProcessAffinity.ico">

    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" FontSize="12"
                   Text="ProcessAffinity keeps applying your saved rules for as long as it runs." />

        <!-- Chaque issue est un bouton suivi de ce qu'elle implique : le libellé
             seul ne distingue pas « quitter » de « réduire » pour qui ne sait pas
             que l'application travaille en arrière-plan. -->
        <Button Name="ExitButton" Height="26" Margin="0,16,0,0" HorizontalAlignment="Stretch"
                Content="Exit ProcessAffinity" Click="ExitButton_Click" />
        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#555555" Margin="4,3,0,0"
                   Text="Your rules stop being applied until you start ProcessAffinity again. Rules already applied to running processes stay as they are." />

        <Button Name="MinimizeButton" Height="26" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                Content="Minimize to the notification area" IsDefault="True" Click="MinimizeButton_Click" />
        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#555555" Margin="4,3,0,0"
                   Text="ProcessAffinity keeps running and keeps applying your rules. Double-click its icon near the clock to bring the window back." />

        <CheckBox Name="RememberCheckBox" Content="Don't ask me again" Margin="0,16,0,0" FontSize="11" />
        <TextBlock Name="RememberHintTextBlock" TextWrapping="Wrap" FontSize="10" Foreground="#555555" Margin="20,3,0,0"
                   Text="The button will do what you choose here, without asking. You can change this from the ? menu, under About." />

        <DockPanel Margin="0,16,0,0">
            <Button Name="CancelButton" Content="Cancel" Width="90" Height="24"
                    HorizontalAlignment="Right" DockPanel.Dock="Right"
                    IsCancel="True" Click="CancelButton_Click" />
        </DockPanel>
    </StackPanel>
</Window>
