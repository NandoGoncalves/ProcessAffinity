<UserControl x:Class="ProcessAffinityUI.ProcessUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" BorderBrush="{x:Null}" BorderThickness="3" FontWeight="Normal" Opacity="1" MouseRightButtonDown="UserControl_MouseRightButtonDown" MouseDown="UserControl_MouseDown" Background= "LightGray"
             VerticalAlignment="Top" HorizontalAlignment="Left">

    <!-- VerticalAlignment="Top" n'est pas décoratif : dans un WrapPanel
         horizontal, un enfant sans contrainte verticale est étiré à la hauteur
         de sa rangée, et celle-ci vaut celle du plus haut. Une tuile doublée en
         bout de rangée étirait donc ses voisines normales de 89 à 145 px, qui
         se déformaient au lieu de laisser du vide.

         La tuile portait auparavant Height="83", qui l'interdisait ; la
         structure en deux rangées, qui lui donne sa hauteur par son contenu,
         a ouvert la porte à cet étirement. L'alignement la referme.

         Reste la place vide autour d'une tuile agrandie : c'est le défaut
         connu du WrapPanel, qui demande un conteneur à cellules — hors de ce
         lot, et chiffré dans la description de la PR.

         Deux rangées, et c'est là tout l'intérêt de la structure : seule la
         première porte la transformation d'échelle.

         La tuile faisait 102 × 83 avec tout en positions absolues, et
         l'agrandissement du lot 5d portait sur la racine — donc sur le nom,
         l'icône et la valeur chiffrée autant que sur les courbes. Agrandir une
         courbe pour la lire mieux n'a aucune raison d'agrandir un nom qui se
         lisait déjà.

         Rangée 0 : les courbes, dans CurvesHost, de taille fixe 102 × 56. Les
         marges des trente-quatre barres sont relatives à cette largeur et n'ont
         pas bougé d'un pixel : le conteneur fait exactement la largeur pour
         laquelle elles ont été écrites. C'est lui, et lui seul, qui grandit.

         Rangée 0 encore, par-dessus : l'icône, la valeur et la case de
         sélection, à leur taille d'origine, alignées sur les bords de la
         cellule — qui grandit avec les courbes sans les entraîner.

         Rangée 1 : le bandeau de nom, étiré sur toute la largeur de la tuile,
         hauteur fixe. Il faisait 96 px de large dans une tuile de 102 ; il
         occupe maintenant la largeur entière, quelle que soit l'échelle. -->
    <Grid Name="TileRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="27" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Name="CurvesHost" Width="102" Height="56">

            <!-- Mémoire : les mêmes colonnes que le CPU, déclarées avant lui pour
                 passer derrière. Gris foncé, sans dégradé : ce sont un arrière-plan,
                 et les barres de CPU peuvent les recouvrir sans que ce soit gênant. -->
            <Label Height="56" HorizontalAlignment="Center" Name="MemoryUsagelabel0" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" Margin="83,0,3,21" />
            <Label Height="56" HorizontalAlignment="Center" Name="MemoryUsagelabel1" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" Margin="81,0,10,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="MemoryUsagelabel2" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" Margin="76,0,15,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="MemoryUsagelabel3" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" Margin="71,0,20,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="MemoryUsagelabel4" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" Margin="66,0,25,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="MemoryUsagelabel5" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" Margin="61,0,30,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="MemoryUsagelabel6" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" Margin="56,0,35,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="MemoryUsagelabel7" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" Margin="51,0,40,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="MemoryUsagelabel8" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" Margin="46,0,45,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="MemoryUsagelabel9" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" Margin="41,0,50,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="MemoryUsagelabel10" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" Margin="36,0,55,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="MemoryUsagelabel11" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" Margin="31,0,60,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="MemoryUsagelabel12" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" Margin="26,0,65,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="MemoryUsagelabel13" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" Margin="21,0,70,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="MemoryUsagelabel14" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" Margin="16,0,75,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="MemoryUsagelabel15" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" Margin="11,0,80,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="MemoryUsagelabel16" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" Margin="6,0,85,0" />

            <!-- Jauge verticale sur le bord gauche, remplie de haut en bas. Elle reste
                 lisible quand les barres de CPU occupent toute la largeur et masquent
                 complètement celles de la mémoire. -->
            <!-- Rail transparent : une jauge vide ne doit rien dessiner, sans quoi
                 elle poserait une bande claire sur chaque tuile. Il ne sert qu'à
                 fixer la hauteur de référence. -->
            <Rectangle Name="MemoryGaugeTrack" Width="3" Height="56" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0" Fill="Transparent" IsHitTestVisible="False" />
            <!-- Plus soutenu que les barres : trois pixels de large disparaîtraient
                 au ton de l'arrière-plan, et c'est précisément quand les barres de
                 CPU masquent tout que cette jauge doit rester lisible. -->
            <Rectangle Name="MemoryGaugeFill" Width="3" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0" Fill="#FF8C8C8C" IsHitTestVisible="False" />

            <Label Height="56" HorizontalAlignment="Center" Name="CPUUsagelabel0" TabIndex="0" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" MouseEnter="CPUUsagelabel_MouseEnter" Margin="83,0,3,21" />
            <Label Height="56" HorizontalAlignment="Center" Name="CPUUsagelabel1" TabIndex="1" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" MouseEnter="CPUUsagelabel_MouseEnter" Margin="81,0,10,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="CPUUsagelabel2" TabIndex="2" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" MouseEnter="CPUUsagelabel_MouseEnter" Margin="76,0,15,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="CPUUsagelabel3" TabIndex="3" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" MouseEnter="CPUUsagelabel_MouseEnter" Margin="71,0,20,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="CPUUsagelabel4" TabIndex="4" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" MouseEnter="CPUUsagelabel_MouseEnter" Margin="66,0,25,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="CPUUsagelabel5" TabIndex="5" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" MouseEnter="CPUUsagelabel_MouseEnter" Margin="61,0,30,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="CPUUsagelabel6" TabIndex="6" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" MouseEnter="CPUUsagelabel_MouseEnter" Margin="56,0,35,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="CPUUsagelabel7" TabIndex="7" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" MouseEnter="CPUUsagelabel_MouseEnter" Margin="51,0,40,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="CPUUsagelabel8" TabIndex="8" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" MouseEnter="CPUUsagelabel_MouseEnter" Margin="46,0,45,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="CPUUsagelabel9" TabIndex="9" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" MouseEnter="CPUUsagelabel_MouseEnter" Margin="41,0,50,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="CPUUsagelabel10" TabIndex="10" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" MouseEnter="CPUUsagelabel_MouseEnter" Margin="36,0,55,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="CPUUsagelabel11" TabIndex="11" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" MouseEnter="CPUUsagelabel_MouseEnter" Margin="31,0,60,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="CPUUsagelabel12" TabIndex="12" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" MouseEnter="CPUUsagelabel_MouseEnter" Margin="26,0,65,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="CPUUsagelabel13" TabIndex="13" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" MouseEnter="CPUUsagelabel_MouseEnter" Margin="21,0,70,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="CPUUsagelabel14" TabIndex="14" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" MouseEnter="CPUUsagelabel_MouseEnter" Margin="16,0,75,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="CPUUsagelabel15" TabIndex="15" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" MouseEnter="CPUUsagelabel_MouseEnter" Margin="11,0,80,0" />
            <Label Height="56" HorizontalAlignment="Center" Name="CPUUsagelabel16" TabIndex="16" VerticalAlignment="top" Width="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Top" FontSize="4" MinWidth="0.2" Opacity="1" FontWeight="Bold" MouseEnter="CPUUsagelabel_MouseEnter" Margin="6,0,85,0" />
        </Grid>

        <!-- Icône, valeur et case de sélection : dans la même cellule que les
             courbes, donc par-dessus, mais hors de CurvesHost — elles gardent
             ainsi leur taille quelle que soit l'échelle. Alignées sur les bords
             de la cellule, elles suivent son agrandissement sans grossir. -->
        <Image Grid.Row="0" Height="24" Width="24" Name="ProcessImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,0" MouseRightButtonDown="ProcessImage_MouseRightButtonDown" />

        <!-- Valeur superposée, en bas à droite de la zone des courbes. Déclarée
             après elles, elle passe devant ; transparente aux clics pour ne pas
             intercepter la sélection. -->
        <TextBlock Grid.Row="0" Text="-" Name="CPUUsageValueTextBlock" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,2" FontSize="9" FontWeight="Bold" Foreground="Black" IsHitTestVisible="False" Visibility="Collapsed">
            <!-- Contour clair : le texte passe alternativement sur le fond du
                 contrôle et sur la barre, dont la teinte s'assombrit avec la
                 charge. Un halo blanc le garde lisible dans les deux cas, sans
                 dépendre d'une estimation du fond. -->
            <TextBlock.Effect>
                <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="4" Opacity="1" />
            </TextBlock.Effect>
        </TextBlock>

        <CheckBox Grid.Row="0" Content="" Name="SelectedUserControlCheckBox" Visibility="Hidden" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,5,0" Width="14" Height="16" />

        <!-- TextBlock et non Label : un libellé de service « Service - Hôte » dépasse
             la largeur disponible, et un Label centré le couperait des deux côtés.
             L'ellipse conserve le début, qui identifie l'entrée ; l'infobulle donne
             le libellé complet. -->
        <TextBlock Grid.Row="1" Text="0000" Height="22" Name="ProcessIDlabel" VerticalAlignment="Top" HorizontalAlignment="Stretch" TextAlignment="Center" TextTrimming="CharacterEllipsis" Padding="0,7,0,0" FontSize="10" FontWeight="SemiBold" Opacity="1" MouseRightButtonDown="ProcessIDlabel_MouseRightButtonDown" />

    </Grid>

</UserControl>
